{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/projects.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/changelog.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/operator/alpin-holding-llc",
      "destination": "/explore",
      "permanent": true
    },
    {
      "source": "/operator/enersmart-storage",
      "destination": "/explore",
      "permanent": true
    },
    {
      "source": "/operator/pacifico-power",
      "destination": "/explore",
      "permanent": true
    },
    {
      "source": "/operator/solar-proponent-llc",
      "destination": "/explore",
      "permanent": true
    },
    {
      "source": "/operator/vantage-data-centers",
      "destination": "/explore",
      "permanent": true
    }
  ]
}
